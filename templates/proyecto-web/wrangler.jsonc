{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cambiar "proyecto-web" por el nombre del cliente en los dos lugares.
  "name": "proyecto-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "proyecto-web"
    }
  ],
  // Optimización de imágenes de next/image con Cloudflare Images.
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
