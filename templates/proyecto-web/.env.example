# Copiar a .env.local para desarrollo. En Cloudflare: las NEXT_PUBLIC_* van como
# variables de build (Workers Builds) y el resto como secretos del Worker.

# URL pública final, sin barra al final. Se usa en metadata, sitemap, robots y JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.dominio.com

# Medición base (brain/workflows/website.md §8). Vacío = no se carga nada.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Formulario de contacto: email del sistema (separado del mailbox humano).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
